MCP_SERVER_NAME=ksher-agent-data-mcp
MCP_ENV=dev
LOG_LEVEL=INFO

# Hard safety limits.
MAX_ROWS=1000
DEFAULT_LIMIT=200
QUERY_TIMEOUT_SECONDS=60
QUERY_MAX_ROWS_TO_READ=50000000
QUERY_MAX_BYTES_TO_READ=5368709120
QUERY_MAX_MEMORY_BYTES=536870912
QUERY_MAX_CONCURRENCY=4
QUERY_REPAIR_MAX_FAILURES=3
# Compare plans may be shortened, but never raised above 900 seconds.
DATA_MCP_QUERY_PLAN_COMPARE_TTL_SECONDS=900
MAX_SQL_BYTES=20000
REQUIRE_PARTITION_FILTER=true

# Metadata catalog source. Use `memory` for local tests; replace with internal provider.
METADATA_PROVIDER=memory

# Credential provider. Do not commit real credentials.
CREDENTIAL_PROVIDER=memory
CREDENTIAL_MEMORY_FILE=examples/credentials.example.json

# Example warehouse addresses. Replace with deployment-local values; do not
# commit production hosts or credentials.
TCHOUSE_C_JDBC_BASE_URL=jdbc:clickhouse://tchouse-c.example.invalid:8123/example_db
TCHOUSE_D_JDBC_URL=jdbc:mysql://tchouse-d.example.invalid:9030/example_db

# TChouse-D account used only for resolving a user's TChouse-C account/password by union_id.
# Set CREDENTIAL_PROVIDER=tchouse_d after these are configured.
TCHOUSE_D_USERNAME=
TCHOUSE_D_PASSWORD=
# Required when CREDENTIAL_PROVIDER=tchouse_d. Keep this deployment-specific SQL
# outside Git. It must accept one union_id parameter and return columns aliased
# as tchouse_account and tchouse_password.
TCHOUSE_D_CREDENTIAL_SQL=

# Required for signed metadata snapshots. Use a fully-qualified database.table
# available to the deployment's read-only warehouse account.
DATA_MCP_METADATA_SNAPSHOT_TABLE=

# Query executor. Use `tchouse_c_http` to execute real TChouse-C SELECT queries.
QUERY_EXECUTOR=dry_run

# Optional fixed-template access inspection. The caller's own TChouse-C credential
# and its configured JDBC entry point are reused. The allowlist contains trusted
# caller/owner union_ids and applies only to the three inspection tools.
DATA_MCP_ACCESS_AUDIT_ALLOWED_UNION_IDS=
DATA_MCP_ACCESS_AUDIT_MAX_ROWS=100000

# Amber trusted-caller adapter. Disabled by default. Run it as a separate process
# with `ksher-agent-data-amber-api`; never expose the internal /agent API to Amber.
DATA_MCP_AMBER_ENABLED=false
DATA_MCP_AMBER_PORT=8766
DATA_MCP_AMBER_JWKS_FILE=
DATA_MCP_AMBER_STATE_DB=
DATA_MCP_AMBER_AUDIT_KEY_FILE=
DATA_MCP_AMBER_ISSUER=amber
DATA_MCP_AMBER_AUDIENCE=data-mcp
DATA_MCP_AMBER_TRUST_DOMAIN=
DATA_MCP_AMBER_CLOCK_SKEW_SECONDS=30
DATA_MCP_AMBER_MAX_TOKEN_LIFETIME_SECONDS=300
DATA_MCP_AMBER_REPLAY_GRACE_SECONDS=120
DATA_MCP_AMBER_TRIAL_MAX_ROWS=20
DATA_MCP_AMBER_SCHEDULE_MAX_CALLS_PER_MINUTE=10
